# IMPACTO HEADSOFTWARE · variáveis de ambiente
# Copie para .env.local (desenvolvimento) e para a pasta de dados do app (produção, feito pelo instalador).

# Supabase (sem estes valores o app roda em MODO LOCAL, com dados de exemplo em .data/db.json)
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo da sessão em modo local (qualquer texto longo e aleatório)
IHS_SECRET=

# IA (opcional: sem a chave, as gerações saem como exemplo marcado)
ANTHROPIC_API_KEY=

# Pasta de dados (uploads, config). Em produção o app desktop define sozinho.
# IHS_DATA_DIR=
